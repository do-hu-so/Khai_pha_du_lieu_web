# Copy file này thành .env.local (chạy local) hoặc khai báo trong Vercel > Settings > Environment Variables

# ---- BẮT BUỘC ----
# Lấy key tại https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# ---- TÙY CHỌN (đã có giá trị mặc định trong lib/rag/config.ts) ----
# Mô hình sinh câu trả lời (xem danh sách: https://console.groq.com/docs/models)
# GROQ_MODEL=openai/gpt-oss-120b
# Mô hình nhanh cho viết lại câu hỏi + reranking (phải hỗ trợ JSON mode)
# GROQ_FAST_MODEL=qwen/qwen3.8-27b

# Chiến lược xếp hạng lại: llm | mmr | none
# RERANKER=llm
# Số chunk đưa vào ngữ cảnh sinh câu trả lời
# RAG_CONTEXT_CHUNKS=6
# Trọng số hợp nhất RRF giữa dense và BM25
# RAG_DENSE_WEIGHT=1.0
# RAG_BM25_WEIGHT=1.0
